/data/lab/*.log
/config/generated_stream_lab.json
/data/uploads/
/data/exports/

# Zeek live conn.log (can grow; recreated by capture script)
/data/live/*.log

# Node (if tools run at repo root)
/node_modules/

# local ML checkpoints / exports (root; keep explicit allows if needed)
/*.pt
/*.pth
/*.onnx
/*.npy
/*.npz

# secrets
.env
kaggle.json

# data (never commit large datasets)
/data/db/
/data/raw/
/data/interim/
/data/processed/
/kaggleData/


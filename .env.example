# Copy to .env and adjust. `scripts/run_api_8000.sh` sources .env automatically.

# Optional: bundle paths (defaults use artifacts/current if unset)
# HAWK_EYE_MODEL_DIR=
# HAWK_EYE_ANOMALY_DIR=

# Deepseek (OpenAI-compatible). Get a key at https://platform.deepseek.com
# Used when OPENAI_API_KEY is unset.
DEEPSEEK_API_KEY=

# Optional: OpenAI instead (overrides Deepseek when both would apply)
# OPENAI_API_KEY=

# Optional overrides (defaults apply when only DEEPSEEK_API_KEY is set)
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# Optional: LLM request tuning (hawk_eye.llm_format)
# HAWK_EYE_LLM_TEMPERATURE=0.15
# HAWK_EYE_LLM_MAX_TOKENS_EXPLAIN=2048
# HAWK_EYE_LLM_MAX_TOKENS_INCIDENT=4096
# HAWK_EYE_LLM_MAX_TOKENS=4096
# HAWK_EYE_LLM_REDACT_IPS=1
